---
import ServiceCardMotion from './ServiceCardMotion.tsx';

const props = Astro.props;
---

<ServiceCardMotion client:load {...props} />

<style is:global>
  .service-card {
    position: relative;
    height: clamp(29rem, 42vw, 32.75rem);
    overflow: hidden;
    border-radius: var(--radius-card);
    background: white;
    isolation: isolate;
  }

  .service-card__media { position: absolute; inset: 0; overflow: hidden; background: var(--color-surface); }
  .service-card__media img { width: 100%; height: 100%; object-fit: cover; }
  .service-card__placeholder { display: grid; width: 100%; height: 100%; place-items: center; color: var(--color-text-muted); background: linear-gradient(135deg, #dbe9f2, #f6fbfe); font-size: .85rem; font-weight: 700; }

  .service-card__price {
    position: absolute;
    z-index: 1;
    bottom: calc(100% + 1rem);
    left: 2rem;
    margin: 0;
    padding: .25rem .55rem;
    border-radius: .35rem;
    color: var(--color-header-accent);
    background: white;
    font-family: var(--font-ui);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .service-card__content {
    position: absolute;
    z-index: 1;
    right: 0;
    bottom: .25rem;
    left: 0;
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: 1.4rem 2rem 2rem;
    border-radius: var(--radius-card);
    background: white;
  }

  .service-card__content h3 { max-width: 16ch; color: var(--color-text); font-family: var(--font-display); font-size: clamp(1.35rem, 2.2vw, 1.75rem); line-height: 1.1; overflow-wrap: break-word; text-wrap: balance; }
  .service-card__description { margin: 0; color: var(--color-text-muted); line-height: 1.55; }
  .service-card__cta-clip { overflow: hidden; }
  .service-card__cta { min-height: 3.5rem; }
  .service-card__cta .button { width: 100%; }

  .service-card__rule { position: absolute; z-index: 2; right: 0; bottom: 0; left: 0; --tricolor-height: .25rem; --tricolor-pulse-scale: 3; }

  @media (hover: none) {
    .service-card { height: auto; min-height: 29rem; }
    .service-card__media { position: relative; aspect-ratio: var(--service-card-image-ratio, 367 / 352); }
    .service-card__content { position: relative; bottom: auto; height: auto; min-height: 0; }
    .service-card__rule { position: relative; }
  }

  @media (max-width: 40rem) {
    .service-card__price { left: 1.25rem; }
    .service-card__content { padding: 1.25rem 1.5rem 1.5rem; }
    .service-card__content h3 { max-width: 100%; font-size: clamp(1.35rem, 8vw, 1.85rem); line-height: 1.12; }
  }
</style>
