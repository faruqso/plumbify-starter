---
const year = new Date().getFullYear();

const socialLinks = [
  {
    href: 'https://twitter.com',
    label: 'Follow Plumbify on X',
    path: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817-5.964 6.817H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.16 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z'
  },
  {
    href: 'https://instagram.com',
    label: 'Follow Plumbify on Instagram',
    path: 'M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm5 3.5A4.5 4.5 0 1 1 12 16.5 4.5 4.5 0 0 1 12 7.5Zm0 2A2.5 2.5 0 1 0 12 14.5 2.5 2.5 0 0 0 12 9.5Zm5.25-3a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5Z'
  },
  {
    href: 'https://youtube.com',
    label: 'Watch Plumbify on YouTube',
    path: 'M21.58 7.19a2.72 2.72 0 0 0-1.91-1.93C18 4.81 12 4.81 12 4.81s-6 0-7.67.45a2.72 2.72 0 0 0-1.91 1.93A28.36 28.36 0 0 0 2 12a28.36 28.36 0 0 0 .42 4.81 2.72 2.72 0 0 0 1.91 1.93c1.67.45 7.67.45 7.67.45s6 0 7.67-.45a2.72 2.72 0 0 0 1.91-1.93A28.36 28.36 0 0 0 22 12a28.36 28.36 0 0 0-.42-4.81ZM10 15.17V8.83L15.2 12 10 15.17Z'
  }
];

import { services } from '../data/services';

const navigationLinks = [
  { href: '/', label: 'Home' },
  { href: '/#about', label: 'About Us' },
  { href: '/services', label: 'Our Services' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' }
];

const serviceLinks = services.slice(0, 4);
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__top">
      <div class="site-footer__intro">
        <p>At Plumbify, we understand the importance of having a reliable plumbing system.</p>
        <div class="site-footer__socials" aria-label="Social links">
          {socialLinks.map((item) => (
            <a href={item.href} aria-label={item.label}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={item.path}></path>
              </svg>
            </a>
          ))}
        </div>
      </div>

      <nav class="site-footer__column" aria-label="Footer navigation">
        <h2>Navigation</h2>
        <ul>
          {navigationLinks.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <div class="site-footer__column">
        <h2>Services</h2>
        <ul>
          {serviceLinks.map((service) => <li><a href={`/services/${service.slug}`}>{service.shortTitle}</a></li>)}
        </ul>
      </div>

      <address class="site-footer__column site-footer__contact">
        <h2>Contact Us</h2>
        <p>Our Support and Sales team is available 24 /7 to answer your queries</p>
        <a href="https://maps.google.com/?q=456+Elm+Avenue,+Springfield,+USA">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"></path></svg>
          456 Elm Avenue, Springfield, USA
        </a>
        <a href="tel:+15551234567">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.62 10.79a15.09 15.09 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.24 1.02l-2.21 2.2Z"></path></svg>
          +1 (555) 123-4567
        </a>
      </address>
    </div>

    <div class="site-footer__brand" aria-label="Plumbify">Plumbify</div>

    <div class="site-footer__bottom">
      <p>Copyright © {year} Plumbify</p>
      <nav aria-label="Legal links">
        <a href="/terms">Terms of Use</a>
        <a href="/privacy">Privacy Policy</a>
      </nav>
    </div>
  </div>
</footer>
