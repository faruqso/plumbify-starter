---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
---

<BaseLayout title="Privacy Policy" description="Privacy policy placeholder for the Day 3 plumbing starter.">
  <Container>
    <article class="panel panel--padded legal stack">
      <p class="eyebrow">Legal</p>
      <h1>Privacy Policy</h1>
      <p>This is placeholder legal copy for the starter. Replace it with your final policy text before launch.</p>
      <p>We will keep this page in the starter so the site is ready for legal content from day one.</p>
    </article>
  </Container>
</BaseLayout>
