---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
---

<BaseLayout title="Terms of Use" description="Terms placeholder for the Day 3 plumbing starter.">
  <Container>
    <article class="panel panel--padded legal stack">
      <p class="eyebrow">Legal</p>
      <h1>Terms of Use</h1>
      <p>This is placeholder legal copy for the starter. Replace it with your final terms before launch.</p>
      <p>The goal is to keep the legal surface area visible while the site is still being designed.</p>
    </article>
  </Container>
</BaseLayout>
