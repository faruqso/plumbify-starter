---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
---

<BaseLayout title="Accessibility" description="Accessibility statement placeholder for the Day 3 plumbing starter.">
  <Container>
    <article class="panel panel--padded legal stack">
      <p class="eyebrow">Legal</p>
      <h1>Accessibility Statement</h1>
      <p>This is placeholder legal copy for the starter. Replace it with your final accessibility statement before launch.</p>
      <p>We are keeping the page in place so accessibility expectations are visible from the start.</p>
    </article>
  </Container>
</BaseLayout>
